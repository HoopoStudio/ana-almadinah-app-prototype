# Copy to .env and `export $(cat .env | xargs)` (or set these in your host's dashboard)
PORT=3000
STAFF_PIN=1234

# --- Odoo sync (leave empty to run the queue standalone) ---
ODOO_URL=https://ana-almadinahart.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# id of the event.event record for the screening day (Events app → open the event → the number in the URL)
ODOO_EVENT_ID=
