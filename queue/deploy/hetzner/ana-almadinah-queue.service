# systemd unit: keeps the queue app running and restarts it after crashes or reboots.
# Install:  sudo cp deploy/hetzner/ana-almadinah-queue.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now ana-almadinah-queue
[Unit]
Description=Ana Al-Madinah VR screening queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queue
Group=queue
WorkingDirectory=/opt/ana-almadinah-queue
EnvironmentFile=/etc/ana-almadinah-queue.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# hardening: the app only needs to write its own data folder
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ana-almadinah-queue
PrivateTmp=true

[Install]
WantedBy=multi-user.target
