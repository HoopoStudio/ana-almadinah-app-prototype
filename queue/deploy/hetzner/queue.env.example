# Copy to /etc/ana-almadinah-queue.env  (chmod 600, owned by root)
PORT=3000
STAFF_PIN=2468
QUEUE_DATA=/var/lib/ana-almadinah-queue/queue.json

# Odoo runs on the same machine, so talk to it locally (fast, never leaves the server).
# If Odoo is in Docker or behind Nginx only, use https://ana-almadinahart.com instead.
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_EVENT_ID=
